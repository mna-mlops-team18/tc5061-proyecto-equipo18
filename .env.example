# Copia este archivo como .env y ajusta los valores para tu computadora.
# .env NUNCA se sube a Git (esta en .gitignore). Este archivo de ejemplo si se
# versiona, asi que aqui no van valores reales ni credenciales.

# URI del servidor de tracking de MLflow que usa el codigo de Python (train, busqueda,
# registro, comparar). Si no se define, se usa el servidor local: http://127.0.0.1:5000
# Ojo: el comando `mlflow run` NO lee este archivo; en su terminal define la variable
# MLFLOW_TRACKING_URI (ver README > Servidor de tracking).
# MLFLOW_TRACKING_URI=http://127.0.0.1:5000

# Espejo opcional de los archivos de MiBici (por defecto, el portal oficial).
# MIBICI_URL_BASE=https://mibici.net/site/assets/files/

# Si en una entrega futura el equipo usa un servidor remoto de MLflow,
# sus credenciales van SOLO en .env, por ejemplo:
# MLFLOW_TRACKING_USERNAME=
# MLFLOW_TRACKING_PASSWORD=

# -----------------------------------------------------------------------------------------------
# Docker Compose (docker-compose.yml). Compose lee este mismo .env; sin definirlas se usan los
# valores por defecto que aparecen aqui. Ver README > Operacion con Docker Compose.
# -----------------------------------------------------------------------------------------------
# Puertos en esta computadora (solo 127.0.0.1). Cambia MLFLOW_PUERTO si ya usas el 5000 con
# `make mlflow-server`.
# API_PUERTO=8000
# MLFLOW_PUERTO=5000

# Tamano del contenedor de la API: es la "instancia" que mide la prueba de carga y que cuesta el
# analisis FinOps. Un worker de uvicorn por vCPU; con mas workers sube tambien la memoria.
# API_CPUS=1.0
# API_MEMORIA=1g
# API_WORKERS=1

# Opcion A: la API carga los modelos del registry de Compose al arrancar (vacias = opcion B, los
# modelos copiados en la imagen). Ejemplo:
# MODELO_URI_P1=models:/mibici-equipo18-p1-demanda@champion
# MODELO_URI_P2=models:/mibici-equipo18-p2-riesgo@champion
# MODELO_URI_P3=models:/mibici-equipo18-p3-grupos@champion
