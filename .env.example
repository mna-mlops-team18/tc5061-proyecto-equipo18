# Copia este archivo como .env y ajusta los valores para tu computadora.
# .env NUNCA se sube a Git (esta en .gitignore). Este archivo de ejemplo si se
# versiona, asi que aqui no van valores reales ni credenciales.

# URI del servidor de tracking de MLflow que usa el codigo de Python (train, busqueda,
# registro, comparar). Si no se define, se usa el servidor local: http://127.0.0.1:5000
# Ojo: el comando `mlflow run` NO lee este archivo; en su terminal define la variable
# MLFLOW_TRACKING_URI (ver README > Servidor de tracking).
# MLFLOW_TRACKING_URI=http://127.0.0.1:5000

# Espejo opcional de los archivos de MiBici (por defecto, el portal oficial).
# MIBICI_URL_BASE=https://mibici.net/site/assets/files/

# Si en una entrega futura el equipo usa un servidor remoto de MLflow,
# sus credenciales van SOLO en .env, por ejemplo:
# MLFLOW_TRACKING_USERNAME=
# MLFLOW_TRACKING_PASSWORD=
